{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot",
  "version": "0.1.0",
  "identifier": "dev.jsb.jot",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "pnpm run build:ui",
    "beforeBuildCommand": "pnpm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quick Note",
        "width": 560,
        "height": 340,
        "minWidth": 420,
        "minHeight": 260,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
